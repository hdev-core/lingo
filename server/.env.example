PORT=3001
NODE_ENV=development

# --- Database (Supabase Postgres) ---
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# --- Hive network ---
HIVE_NETWORK=mainnet

# --- App account (broadcasts lingo_commit / lingo_reveal) ---
HIVE_APP_ACCOUNT=your-dedicated-mainnet-app-account
HIVE_APP_POSTING_KEY=your-dedicated-mainnet-posting-key

# --- Hive-Engine (LINGO token reads via sscjs) ---
HIVE_ENGINE_NODE=https://api.hive-engine.com/rpc
LINGO_TOKEN_SYMBOL=LINGO

# --- Auth / sessions ---
SESSION_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# --- Allowed frontend origins ---
ALLOWED_ORIGINS=http://localhost:5173